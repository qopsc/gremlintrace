#!/usr/bin/env python3
"""Strict stand-in for mongo-tools mongodump.

Mirrors mongo-tools' config-file contract: the YAML/JSON file given to --config
is decoded with UnmarshalStrict into a struct whose only fields are password,
uri, sslPEMKeyPassword and destinationPassword. Any other key is a hard error.
Credentials other than the password must therefore arrive as flags.
"""
import gzip
import json
import os
import sys

ALLOWED = {"password", "uri", "sslPEMKeyPassword", "destinationPassword"}
args = sys.argv[1:]
opts = {}
flags = set()
i = 0
while i < len(args):
    a = args[i]
    if a.startswith("--") and i + 1 < len(args) and not args[i + 1].startswith("--"):
        opts[a] = args[i + 1]
        i += 2
    else:
        flags.add(a)
        i += 1

if "--password" in opts or "-p" in opts:
    sys.stderr.write("fake mongodump: password passed on argv\n")
    sys.exit(3)

if "--config" in opts:
    with open(opts["--config"], encoding="utf-8") as handle:
        config = json.load(handle)
    unknown = sorted(set(config) - ALLOWED)
    if unknown:
        sys.stderr.write(
            "error parsing config file: yaml: unmarshal errors: field %s not found\n"
            % unknown[0]
        )
        sys.exit(1)
    if "password" not in config and "uri" not in config:
        sys.stderr.write("fake mongodump: config has no password/uri\n")
        sys.exit(1)

for required in ("--username", "--authenticationDatabase", "--db"):
    if required not in opts:
        sys.stderr.write("fake mongodump: missing %s\n" % required)
        sys.exit(2)
if "--archive" not in flags or "--gzip" not in flags:
    sys.stderr.write("fake mongodump: expected --archive --gzip\n")
    sys.exit(2)

record = "FAKE_MONGODUMP_RECORD"
if os.environ.get(record):
    with open(os.environ[record], "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"opts": opts, "flags": sorted(flags)}) + "\n")

sys.stdout.buffer.write(gzip.compress(b"mongo-archive-" + opts["--db"].encode()))
