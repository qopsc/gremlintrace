#!/usr/sbin/nft -f
# Managed by codereviewer host_firewall role.
# table + delete + replace in one transaction so a load failure keeps prior rules.

table inet {{ host_firewall_nftables_table_name }}
delete table inet {{ host_firewall_nftables_table_name }}

table inet {{ host_firewall_nftables_table_name }} {
  chain input {
    type filter hook input priority 0; policy drop;

    iif "lo" accept
    ct state established,related accept

    iifname "veth-*" tcp dport 5010-5012 accept
    iifname "veth-*" tcp dport 5016-5018 accept
    iifname "veth-*" drop

    # ICMP/ICMPv6 after the veth drop: neighbour discovery, router
    # advertisements and path-MTU must work on the uplink, but sandboxes still
    # cannot ping the host.
    meta l4proto { icmp, ipv6-icmp } accept

    tcp dport { {{ host_firewall_ssh_ports | map('string') | join(', ') }}, 80, 443 } accept
  }
}
