#!/usr/sbin/nft -f
# Managed by codereviewer host_firewall role.
# Replaces only the qops_filter table; Docker and orchestrator tables are untouched.

table inet {{ host_firewall_nftables_table_name }} {
  chain input {
    type filter hook input priority 0; policy drop;

    iif "lo" accept
    ct state established,related accept

    iifname "veth-*" tcp dport 5010-5012 accept
    iifname "veth-*" tcp dport 5016-5018 accept
    iifname "veth-*" drop

    tcp dport { 22, 80, 443 } accept
  }
}
