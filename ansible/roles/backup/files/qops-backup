#!/usr/bin/env bash
# M1 backup: both Postgres instances, mongodump, RabbitMQ definitions, /etc/qops.
# Does not back up the template store, S3/NFS, or ClickHouse (M2).
set -euo pipefail
# The single-quoted shell snippets below are intentionally evaluated in the
# container by docker compose, not by this host shell.

ROOT="${QOPS_BACKUP_ROOT:-/var/backups/qops}"
RETENTION_DAYS="${QOPS_BACKUP_RETENTION_DAYS:-7}"
DOCKER_BIN="${QOPS_BACKUP_DOCKER:-docker}"
SECRETS="${QOPS_BACKUP_SECRETS:-/etc/qops/secrets.env}"
QOPS_DIR="${QOPS_BACKUP_QOPS_DIR:-/etc/qops}"
KODUS_DIR="${QOPS_BACKUP_KODUS_DIR:-/opt/kodus-installer}"
KODUS_ENV="${QOPS_BACKUP_KODUS_ENV:-${KODUS_DIR}/.env}"
KODUS_COMPOSE="${QOPS_BACKUP_KODUS_COMPOSE:-${KODUS_DIR}/docker-compose.yml}"
KODUS_OVERRIDE="${QOPS_BACKUP_KODUS_OVERRIDE:-${KODUS_DIR}/docker-compose.override.yml}"
E2B_COMPOSE="${QOPS_BACKUP_E2B_COMPOSE:-/etc/qops/e2b-data/docker-compose.yml}"
E2B_PROJECT="${QOPS_BACKUP_E2B_PROJECT:-e2b-data}"
E2B_PG_USER="${QOPS_BACKUP_E2B_PG_USER:-postgres}"
E2B_PG_DB="${QOPS_BACKUP_E2B_PG_DB:-e2b}"
VERIFY_BIN="${QOPS_BACKUP_VERIFY:-/usr/local/bin/qops-backup-verify}"
STAMP="${QOPS_BACKUP_STAMP:-$(date -u +%Y-%m-%dT%H%M%SZ)}"

read_dotenv() {
  local file="$1"
  local key="$2"
  python3 - "${file}" "${key}" <<'PY'
import os
import sys

path, key = sys.argv[1], sys.argv[2]
if not os.path.isfile(path):
    raise SystemExit(f"missing {path}")
value = None
with open(path, encoding="utf-8") as handle:
    for raw in handle:
        line = raw.rstrip("\n")
        if not line or line.lstrip().startswith("#"):
            continue
        if line.startswith(key + "="):
            value = line.split("=", 1)[1]
if value is None:
    raise SystemExit(f"missing key {key} in {path}")
sys.stdout.write(value)
PY
}

compose_kodus() {
  local -a files
  files=(-f "${KODUS_COMPOSE}")
  if [[ -f "${KODUS_OVERRIDE}" ]]; then
    files+=(-f "${KODUS_OVERRIDE}")
  fi
  "${DOCKER_BIN}" compose --project-directory "${KODUS_DIR}" "${files[@]}" \
    --env-file "${KODUS_ENV}" "$@"
}

compose_e2b() {
  "${DOCKER_BIN}" compose --project-name "${E2B_PROJECT}" \
    --env-file "${SECRETS}" -f "${E2B_COMPOSE}" "$@"
}

if [[ ! -x "${DOCKER_BIN}" ]] && ! command -v "${DOCKER_BIN}" >/dev/null 2>&1; then
  echo "docker not found: ${DOCKER_BIN}" >&2
  exit 1
fi

mkdir -p "${ROOT}"
chmod 0750 "${ROOT}"
DEST="${ROOT}/${STAMP}"
mkdir -p "${DEST}"
chmod 0750 "${DEST}"

PG_USER="$(read_dotenv "${KODUS_ENV}" API_PG_DB_USERNAME)"
PG_DB="$(read_dotenv "${KODUS_ENV}" API_PG_DB_DATABASE)"
MG_USER="$(read_dotenv "${KODUS_ENV}" API_MG_DB_USERNAME)"
MG_PASS="$(read_dotenv "${KODUS_ENV}" API_MG_DB_PASSWORD)"
MG_DB="$(read_dotenv "${KODUS_ENV}" API_MG_DB_DATABASE)"

compose_kodus exec -T db_kodus_postgres \
  pg_dump -U "${PG_USER}" --format=plain --no-owner --no-acl "${PG_DB}" \
  | gzip -c >"${DEST}/kodus-postgres.sql.gz"

compose_e2b exec -T postgres \
  pg_dump -U "${E2B_PG_USER}" --format=plain --no-owner --no-acl "${E2B_PG_DB}" \
  | gzip -c >"${DEST}/e2b-postgres.sql.gz"

MONGO_CONFIG="$({
  MONGO_USER="${MG_USER}" MONGO_PASSWORD="${MG_PASS}" MONGO_DATABASE="${MG_DB}" \
    python3 - <<'PY'
import json
import os

print(json.dumps({
    "username": os.environ["MONGO_USER"],
    "password": os.environ["MONGO_PASSWORD"],
    "authenticationDatabase": "admin",
    "db": os.environ["MONGO_DATABASE"],
}))
PY
})"
# shellcheck disable=SC2016
printf '%s\n' "${MONGO_CONFIG}" |
  compose_kodus exec -T db_kodus_mongodb sh -eu -c '
    config_file="$(mktemp)"
    trap '\''rm -f "${config_file}"'\'' EXIT
    cat >"${config_file}"
    mongodump --config "${config_file}" --archive --gzip
  ' >"${DEST}/mongo.archive.gz"

# shellcheck disable=SC2016
compose_kodus exec -T rabbitmq sh -eu -c '
  definitions_file="$(mktemp)"
  trap '\''rm -f "${definitions_file}"'\'' EXIT
  rabbitmqctl export_definitions "${definitions_file}" >/dev/null
  cat "${definitions_file}"
' >"${DEST}/rabbitmq-definitions.json"
python3 - "${DEST}/rabbitmq-definitions.json" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
json.loads(path.read_text(encoding="utf-8"))
PY

tar -C "$(dirname "${QOPS_DIR}")" -czf "${DEST}/etc-qops.tar.gz" "$(basename "${QOPS_DIR}")"

python3 - "${DEST}" "${STAMP}" <<'PY'
import hashlib
import json
import pathlib
import sys

dest = pathlib.Path(sys.argv[1])
stamp = sys.argv[2]
names = [
    "kodus-postgres.sql.gz",
    "e2b-postgres.sql.gz",
    "mongo.archive.gz",
    "rabbitmq-definitions.json",
    "etc-qops.tar.gz",
]
lines = []
for name in names:
    path = dest / name
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    lines.append(f"{digest}  {name}")
(dest / "SHA256SUMS").write_text("\n".join(lines) + "\n", encoding="utf-8")
manifest = {
    "created_at": stamp,
    "version": 1,
    "milestone": "M1",
    "files": names + ["SHA256SUMS", "MANIFEST.json"],
    "components": [
        "kodus-postgres",
        "e2b-postgres",
        "mongo",
        "rabbitmq-definitions",
        "etc-qops",
    ],
}
(dest / "MANIFEST.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
PY

if [[ ! -x "${VERIFY_BIN}" ]] && ! command -v "${VERIFY_BIN}" >/dev/null 2>&1; then
  echo "qops-backup-verify missing: ${VERIFY_BIN}" >&2
  exit 1
fi
"${VERIFY_BIN}" "${DEST}"

ln -sfn "${DEST}" "${ROOT}/latest"

if [[ "${RETENTION_DAYS}" =~ ^[0-9]+$ ]] && [[ "${RETENTION_DAYS}" -gt 0 ]]; then
  latest_resolved="$(readlink -f "${ROOT}/latest")"
  find "${ROOT}" -mindepth 1 -maxdepth 1 -type d -mtime "+${RETENTION_DAYS}" \
    ! -path "${latest_resolved}" -exec rm -rf {} +
fi

echo "ok ${DEST}"
