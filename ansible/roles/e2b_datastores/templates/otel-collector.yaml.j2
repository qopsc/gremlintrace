receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:{{ e2b_datastores_otel_grpc_port }}
        max_recv_msg_size_mib: 100
        read_buffer_size: 10943040
        max_concurrent_streams: 200
        write_buffer_size: 10943040

processors:
  batch:
    timeout: 5s
  batch/clickhouse:
    timeout: 5s
    send_batch_size: 50000
  filter/external_metrics:
    metrics:
      include:
        match_type: regexp
        metric_names:
          - "e2b.*"

extensions:
  health_check:
    endpoint: 0.0.0.0:{{ e2b_datastores_otel_health_port }}

exporters:
  debug:
    verbosity: detailed
  clickhouse:
    endpoint: tcp://clickhouse:{{ e2b_datastores_clickhouse_native_port }}
    database: {{ e2b_datastores_clickhouse_db }}
    username: ${env:E2B_CLICKHOUSE_USERNAME}
    password: ${env:E2B_CLICKHOUSE_PASSWORD}
    async_insert: true
    create_schema: false
    metrics_tables:
      gauge:
        name: "metrics_gauge"
      sum:
        name: "metrics_sum"

service:
  telemetry:
    logs:
      level: warn
    metrics:
      readers:
        - periodic:
            exporter:
              otlp:
                protocol: grpc
                insecure: true
                endpoint: 127.0.0.1:{{ e2b_datastores_otel_grpc_port }}
  extensions:
    - health_check
  pipelines:
    metrics/external:
      receivers: [otlp]
      processors: [filter/external_metrics, batch/clickhouse]
      exporters: [clickhouse]
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [debug]
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [debug]
