# Per-host operator secrets. Copy to host_vars/<your-host>/secrets.sops.yml,
# fill in, then encrypt in place:
#   sops --encrypt --in-place ansible/inventory/host_vars/<your-host>/secrets.sops.yml
# Only the ".sops.yml" file is loaded (and decrypted) by Ansible; this
# ".example" file is never read. Keys you do not need may be deleted.

# Lego environment for tls_acme_dns_provider (tls_mode=acme_dns). Porkbun shown;
# see ansible/roles/traefik/files/install-traefik-acme-env.sh for other providers.
tls_acme_dns_credentials:
  PORKBUN_API_KEY: pk1_replace
  PORKBUN_SECRET_API_KEY: sk1_replace

# LLM key written into Kodus .env by the kodus role.
kodus_openai_api_key: sk-replace

# Optional Kodus license key (leave empty for community edition).
kodus_license_key: ""
